{
  "name": "auratranslate",
  "version": "0.3.2",
  "private": true,
  "description": "AuraTranslate",
  "scripts": {
    "test": "node --test",
    "build": "node scripts/build-ui.cjs",
    "build:check": "node scripts/build-ui.cjs --check",
    "dev": "node scripts/build-ui.cjs --watch",
    "icons": "node scripts/build-icons.cjs",
    "pretest": "npm run build:check",
    "preview": "node scripts/preview-ui.cjs",
    "test:ui:browser": "npm run build:check && node scripts/check-ui-browser.cjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "playwright": "^1.63.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
